#!/bin/sh
# Phase 4：nginx 镜像的 /docker-entrypoint.sh 会 source 本文件（*.envsh，按文件名排序，先于 20-envsubst-on-templates.sh）。
#   1. 给模板里新增的 VOD_* 变量补开发默认值并校验格式（默认值只是开发默认，不是基准或承诺）；
#   2. 检查 HLS_SECRET / ORIGIN_SECRET：VOD_ENV 不是 dev 时，为空、等于 dev 或短于 VOD_MIN_SECRET_LENGTH 就退出，
#      容器起不来；dev 下只警告，ORIGIN_SECRET 为空时退回 dev（与 api 的同名逻辑一致），保证一条命令能起栈；
#   3. 按 VOD_CORS_ORIGINS（逗号分隔，或 *）生成 map $http_origin $vod_cors_origin。
# 日志只写变量名，不写值。本文件被 source，exit 会让入口脚本失败退出（它带 set -e）。

vod_log() { echo "05-vod-env: $*" >&2; }

vod_lower() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -d ' \t'; }

vod_is_dev() {
    case "$(vod_lower "${VOD_ENV:-dev}")" in
        ""|dev) return 0 ;;
        *) return 1 ;;
    esac
}

vod_weak() {
    _vod_v="$1"
    _vod_l="$(vod_lower "$_vod_v")"
    if [ -z "$_vod_l" ] || [ "$_vod_l" = "dev" ] || [ "${#_vod_v}" -lt "$VOD_MIN_SECRET_LENGTH" ]; then
        return 0
    fi
    return 1
}

# 变量名 + 扩展正则：格式不对直接退出（这些值会原样进 nginx 配置）
vod_require() {
    eval "_vod_val=\${$1}"
    if ! printf '%s' "$_vod_val" | grep -Eq "^($2)\$"; then
        vod_log "invalid value for $1"
        exit 1
    fi
}

: "${VOD_ENV:=dev}"
: "${VOD_MIN_SECRET_LENGTH:=32}"
: "${VOD_KEY_RATE:=20r/s}"
: "${VOD_KEY_BURST:=40}"
: "${VOD_QOE_RATE:=10r/s}"
: "${VOD_QOE_BURST:=20}"
: "${VOD_QOE_MAX_BODY:=16k}"
: "${VOD_HLS_IMMUTABLE_MAX_AGE:=86400}"
: "${VOD_HLS_PLAYLIST_MAX_AGE:=10}"
: "${VOD_HLS_SEGMENT_MAX_AGE:=86400}"
: "${VOD_HLS_EDGE_CACHE_VALID:=7d}"
: "${VOD_CORS_ORIGINS:=http://localhost:8080,http://127.0.0.1:8080}"
: "${VOD_CORS_MAX_AGE:=600}"
export VOD_ENV VOD_MIN_SECRET_LENGTH VOD_KEY_RATE VOD_KEY_BURST VOD_QOE_RATE VOD_QOE_BURST VOD_QOE_MAX_BODY \
    VOD_HLS_IMMUTABLE_MAX_AGE VOD_HLS_PLAYLIST_MAX_AGE VOD_HLS_SEGMENT_MAX_AGE VOD_HLS_EDGE_CACHE_VALID \
    VOD_CORS_ORIGINS VOD_CORS_MAX_AGE

vod_require VOD_MIN_SECRET_LENGTH '[0-9]{1,4}'
vod_require VOD_KEY_RATE '[0-9]{1,6}r/[sm]'
vod_require VOD_QOE_RATE '[0-9]{1,6}r/[sm]'
vod_require VOD_KEY_BURST '[0-9]{1,6}'
vod_require VOD_QOE_BURST '[0-9]{1,6}'
vod_require VOD_QOE_MAX_BODY '[0-9]{1,9}[kKmM]?'
vod_require VOD_HLS_IMMUTABLE_MAX_AGE '[0-9]{1,10}'
vod_require VOD_HLS_PLAYLIST_MAX_AGE '[0-9]{1,10}'
vod_require VOD_HLS_SEGMENT_MAX_AGE '[0-9]{1,10}'
vod_require VOD_HLS_EDGE_CACHE_VALID '[0-9]{1,6}[smhdwMy]?'
vod_require VOD_CORS_MAX_AGE '[0-9]{1,6}'

# ---------- 密钥 ----------
if [ -z "${ORIGIN_SECRET:-}" ] && vod_is_dev; then
    ORIGIN_SECRET=dev
fi
export ORIGIN_SECRET
_vod_weak=""
for _vod_name in HLS_SECRET ORIGIN_SECRET; do
    eval "_vod_secret=\${$_vod_name:-}"
    # 密钥会原样写进 nginx 配置（secure_link_md5 与回源头）：只允许不会破坏配置的字符
    if [ -n "$_vod_secret" ] && ! printf '%s' "$_vod_secret" | grep -Eq '^[A-Za-z0-9._~+/=:-]+$'; then
        vod_log "$_vod_name contains characters nginx config cannot carry; use openssl rand -hex 32"
        exit 1
    fi
    if vod_weak "$_vod_secret"; then
        _vod_weak="$_vod_weak $_vod_name"
    fi
done
if [ -n "$_vod_weak" ]; then
    if vod_is_dev; then
        vod_log "weak or missing secrets:$_vod_weak (allowed only because VOD_ENV=dev)"
    else
        vod_log "weak or missing secrets:$_vod_weak (empty, 'dev' or shorter than $VOD_MIN_SECRET_LENGTH); refusing to start with VOD_ENV=$VOD_ENV"
        exit 1
    fi
fi

# ---------- CORS 白名单 ----------
_vod_conf="${VOD_NGINX_CONF_DIR:-/etc/nginx/conf.d}/00-vod-cors.conf"
{
    echo "# generated by 05-vod-env.envsh from VOD_CORS_ORIGINS; do not edit"
    echo 'map $http_origin $vod_cors_origin {'
    if [ "$VOD_CORS_ORIGINS" = "*" ]; then
        echo '    default "*";'
    else
        echo '    default "";'
        for _vod_origin in $(printf '%s' "$VOD_CORS_ORIGINS" | tr ',' ' '); do
            if printf '%s' "$_vod_origin" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$'; then
                echo "    \"$_vod_origin\" \$http_origin;"
            else
                vod_log "ignoring invalid CORS origin entry"
            fi
        done
    fi
    echo '}'
} > "$_vod_conf"
unset _vod_v _vod_l _vod_val _vod_weak _vod_name _vod_secret _vod_conf _vod_origin
